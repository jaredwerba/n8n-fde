# Copy to .env and replace every change-me value before `docker compose up`.
# .env is gitignored. Do not commit it.

# Stable release checked 2026-10-05. Not the beta tag.
N8N_VERSION=2.41.7

POSTGRES_USER=change-me-root
POSTGRES_PASSWORD=change-me-root-password
POSTGRES_DB=n8n

POSTGRES_NON_ROOT_USER=change-me-n8n
POSTGRES_NON_ROOT_PASSWORD=change-me-n8n-password

# openssl rand -hex 32
RUNNERS_AUTH_TOKEN=change-me-runner-token
N8N_ENCRYPTION_KEY=change-me-encryption-key

GENERIC_TIMEZONE=America/New_York
WEBHOOK_URL=http://localhost:5678/
